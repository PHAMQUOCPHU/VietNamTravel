VITE_DEV_SERVER_PORT=5174
# Local: URL backend (vd. http://localhost:5001). Không có trailing slash.
VITE_BACKEND_URL=http://localhost:5001

# (Tuỳ chọn) Timeout request HTTP (ms). Mặc định 120000 để chờ backend cold-start.
# VITE_HTTP_TIMEOUT_MS=120000

# Vercel (Production): Project → Settings → Environment Variables
# - BẮT BUỘC: VITE_BACKEND_URL = URL API công khai, ưu tiên HTTPS, KHÔNG localhost.
#   Ví dụ: https://ten-api.onrender.com (trang vercel.app là HTTPS → http:// API thường bị mixed content / timeout).
# - Gõ thử trong trình duyệt: {VITE_BACKEND_URL}/api/health → phải thấy {"ok":true,...}
# - Sau khi sửa env: Redeploy (Vite embed biến lúc build).
# - Root directory monorepo: thường đặt `frontend`.
