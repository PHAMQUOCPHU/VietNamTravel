PORT=5001
JWT_SECRET=your_jwt_secret

# Gmail (ứng dụng): App Password vào SENDER_PASSWORD
# SENDER_EMAIL=...
# SENDER_PASSWORD=...

# Nếu Render/hosting báo ENETUNREACH tới smtp.gmail.com :465 → thử STARTTLS cổng 587:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Frontend production KHÔNG phải *.vercel.app (domain riêng) — thêm origin đầy đủ HTTPS, cách nhau dấu phẩy:
# CORS_EXTRA_ORIGINS=https://www.ban-domain.com
