PORT=5001
JWT_SECRET=your_jwt_secret

# MongoDB Atlas hoặc local (bắt buộc để khởi động server)
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Gmail (ứng dụng): App Password vào SENDER_PASSWORD
# SENDER_EMAIL=...
# SENDER_PASSWORD=...

# Resend (HTTPS): chỉ bật khi MAIL_USE_RESEND=true và SMTP không đi được trên hosting:
# MAIL_USE_RESEND=true
# RESEND_API_KEY=re_xxxx
# RESEND_FROM=VietNam Travel <onboarding@resend.dev>
#
# SMTP (chỉ local / VPS mở được cổng SMTP):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Frontend production KHÔNG phải *.vercel.app (domain riêng) — thêm origin đầy đủ HTTPS, cách nhau dấu phẩy:
# CORS_EXTRA_ORIGINS=https://www.ban-domain.com
