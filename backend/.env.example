PORT=5001
JWT_SECRET=your_jwt_secret

# Gmail (ứng dụng): App Password vào SENDER_PASSWORD
# SENDER_EMAIL=...
# SENDER_PASSWORD=...

# Nếu Render/hosting chặn SMTP (ENETUNREACH dù đã 587): dùng Resend (HTTPS, miễn phí tier):
# RESEND_API_KEY=re_xxxx
# RESEND_FROM=VietNam Travel <onboarding@resend.dev>
# (Hoặc domain đã xác minh: "VietNam Travel <noreply@yourdomain.com>")
#
# SMTP (chỉ local / VPS mở được cổng SMTP):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Frontend production KHÔNG phải *.vercel.app (domain riêng) — thêm origin đầy đủ HTTPS, cách nhau dấu phẩy:
# CORS_EXTRA_ORIGINS=https://www.ban-domain.com
